{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "josiah-portfolio",
  "main": "worker/index.ts",
  "account_id": "40687c1a299192a1ba3add80961e429f",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 50 },
  "routes": [{ "pattern": "josiahadeyemo.me", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api", "/api/*"],
  },
  "vars": {
    "SITE_ORIGIN": "https://josiahadeyemo.me",
    "GITHUB_USERNAME": "billioncodes001",
    "GITHUB_SYNC_ENABLED": "true",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "josiah-portfolio-db",
      "database_id": "d7d556e8-0e8c-4778-8ce2-db4c0113d6bb",
      "migrations_dir": "migrations",
    },
  ],
}
