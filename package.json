{
  "name": "josiah-adeyemo-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint src server shared worker scripts/audit-public.ts vite.config.ts playwright.config.ts tests",
    "test": "tsx --test server/*.test.ts",
    "test:e2e": "playwright test",
    "inbox": "tsx --env-file-if-exists=.env server/inbox.ts",
    "audit:public": "tsx scripts/audit-public.ts",
    "worker:bundle": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --outdir .worker-build",
    "test:worker": "npm run worker:bundle && tsx --test worker/*.test.ts",
    "worker:migrate:local": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler d1 migrations apply josiah-portfolio-db --local",
    "dev:worker": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --local --ip 127.0.0.1 --port 4174 --local-upstream 127.0.0.1:4174 --var SITE_ORIGIN:http://127.0.0.1:4174",
    "test:e2e:worker": "PORTFOLIO_RUNTIME=worker playwright test",
    "deploy:check": "node scripts/check-deployment.mjs",
    "deploy:cloudflare": "npm run deploy:check && wrangler d1 migrations apply josiah-portfolio-db --remote && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.2.6",
    "@fontsource/manrope": "^5.2.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "tsx": "^4.20.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/workers-types": "5.20260911.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.3.0",
    "json5": "2.2.3",
    "miniflare": "5.20260911.0-alpha",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "wrangler": "4.131.1"
  }
}
