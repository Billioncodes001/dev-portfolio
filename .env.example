PORT=3001
HOST=127.0.0.1
# Public origin used to validate browser contact submissions. No trailing slash.
SITE_ORIGIN=http://localhost:5173
# Use a persistent volume for this directory in production.
DATA_DIR=./data
# Set only behind a trusted reverse proxy, e.g. loopback.
# TRUST_PROXY=loopback

# Public repository discovery; new public projects appear within about 6 minutes.
GITHUB_USERNAME=billioncodes001
GITHUB_SYNC_ENABLED=true
# Optional server-only token for higher GitHub API rate limits. Never use VITE_ here.
# GITHUB_TOKEN=
